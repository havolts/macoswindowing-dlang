{
  "authors": ["havolts"],
  "copyright": "Copyright © 2026, havolts",
  "description": "A minimal windowing library.",
  "license": "proprietary",
  "name": "d-windowing",
  "dependencies": {
    "d-apple": {
      "repository": "git+https://github.com/havolts/d-apple.git",
      "version": "~main"
    }
  },
  "targetType": "library",
  "libs": ["WindowModule", "OSXWindowDelegate"],
  "lflags": ["-L$PACKAGE_DIR/libs/", "-L$PACKAGE_DIR/source/osxwindowing/"],
  "sourcePaths": ["source"],
  "importPaths": ["source"],
  "preBuildCommands": [
    "clang -c source/osxwindowing/OSXWindowDelegate.m -o source/osxwindowing/OSXWindowDelegate.o",
    "ar rcs source/osxwindowing/libOSXWindowDelegate.a source/osxwindowing/OSXWindowDelegate.o"
  ]
}
